class Solution {
    public double findMaxAverage(int[] nums, int k) {
        
        double maxAvg = 0.0;
        int left = 0;
        int right = k-1;
        double sum = 0.0;
        for(int i = 0; i <= right; i++){
            sum += nums[i];
        }
        maxAvg = sum / k;
        while(right < nums.length - 1){
            sum = sum - nums[left];
            left++;
            right++;
            sum = sum + nums[right];
            maxAvg = Math.max(maxAvg,sum/k);
        }

        return maxAvg;
    }
}
